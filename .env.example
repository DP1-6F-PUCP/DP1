# ==============================================================================
# Variables de Entorno - PaqRap (DP1)
# ==============================================================================

# Configuración de base de datos PostgreSQL
DB_NAME=sysmile_db
DB_USER=sysmile_user
# OBLIGATORIA: docker-compose.yml y el backend ya no traen clave por defecto. setup-server.sh la
# reemplaza por una aleatoria al crear .env. OJO: si el volumen postgres_data ya existe, Postgres
# conserva la clave con que se creó; aquí debe ir ESA clave (cambiarla aquí no la cambia en la base).
# Desarrollo local sin Docker: arrancar el backend con SPRING_PROFILES_ACTIVE=dev (usa la clave local).
DB_PASSWORD=cambiar_por_una_clave_segura
DB_PORT=5432

# Ruta al archivo de credenciales de Docker (para Watchtower)
# Por defecto en root: /root/.docker/config.json
# Para usuario ubuntu/debian: /home/ubuntu/.docker/config.json
DOCKER_CONFIG_PATH=/root/.docker/config.json

# Intervalo en segundos para que Watchtower revise si hay nuevas versiones en GHCR
WATCHTOWER_INTERVAL=60

# Ruta base de Dozzle (en local usar '/', en servidor detrás de Nginx usar '/dozzle')
DOZZLE_BASE=/

# Interfaz donde se publican Adminer (8082) y Dozzle (8888). Por defecto solo localhost (127.0.0.1):
# se llega por túnel SSH o por un Nginx del mismo host. Poner 0.0.0.0 solo si están detrás de
# autenticación.
ADMIN_BIND=127.0.0.1
