# ==============================================================================
# Variables de Entorno - PaqRap (DP1)
# ==============================================================================

# Configuración de base de datos PostgreSQL
DB_NAME=sysmile_db
DB_USER=sysmile_user
DB_PASSWORD=sysmile_password
DB_PORT=5432

# Ruta al archivo de credenciales de Docker (para Watchtower)
# Por defecto en root: /root/.docker/config.json
# Para usuario ubuntu/debian: /home/ubuntu/.docker/config.json
DOCKER_CONFIG_PATH=/root/.docker/config.json

# Intervalo en segundos para que Watchtower revise si hay nuevas versiones en GHCR
WATCHTOWER_INTERVAL=60
